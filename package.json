{
  "name": "okx-wallet-alert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "bunx --bun tsx /prisma/seed.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev --name",
    "db:studio": "bunx --bun prisma studio",
    "pm2:start": "next build --webpack && pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:restart": "next build --webpack && pm2 restart okx-wallet-alert",
    "pm2:stop": "pm2 stop okx-wallet-alert",
    "pm2:delete": "pm2 delete okx-wallet-alert",
    "pm2:logs": "pm2 logs okx-wallet-alert --lines 200",
    "pm2:status": "pm2 status"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.570.0",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "webpack-obfuscator": "^3.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
